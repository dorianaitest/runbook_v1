# n8n workflow automation
# Full reference: https://docs.n8n.io/hosting/configuration/environment-variables/

# ── PostgreSQL backend ───────────────────────────────────────────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=change-me

# ── Security ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me

# ── Networking ───────────────────────────────────────────────────────────
N8N_HOST=n8n.demo-ki-instanz.de
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://n8n.demo-ki-instanz.de/
N8N_PROXY_HOPS=1

# ── Localisation ─────────────────────────────────────────────────────────
GENERIC_TIMEZONE=Europe/Berlin

# ── Data retention (DSGVO: prune executions older than 30 days) ──────────
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=720
