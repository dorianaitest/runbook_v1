# Observability stack: Loki + Promtail + Grafana

# Grafana admin login password
# Change immediately after first login via the Grafana UI
GRAFANA_ADMIN_PASSWORD=change-me
# Mailjet SMTP credentials for Grafana alert email
# Get these from the Mailjet dashboard, do not commit real values here
MAILJET_API_KEY=change-me
MAILJET_SMTP_SECRET=change-me
