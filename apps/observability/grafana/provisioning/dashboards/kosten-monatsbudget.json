  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "LLM-Budget verbraucht (LiteLLM-Limit)",
      "description": "Spend-ZÃ¤hler des Virtual Keys 'librechat-instance' gegen sein max_budget â€” exakt der Wert, gegen den LiteLLM sperrt. Limit und Reset kommen live aus der DB; Limit-Ã„nderungen via /key/update erscheinen automatisch.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round((spend / NULLIF(max_budget, 0) * 100)::numeric, 1) AS \"Prozent\" FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Gesamtkosten vs. Gesamtbudget",
      "description": "LLM-Spend (LiteLLM-Key) + FixbetrÃ¤ge Serper/Firecrawl/Jina (Dashboard-Variablen oben) gegen die Variable 'Gesamtbudget'. Dezimaltrenner in den Variablen: Punkt, nicht Komma.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(((spend + ${serper_usd} + ${firecrawl_usd} + ${jina_usd}) / NULLIF(${gesamtbudget_usd}, 0) * 100)::numeric, 1) AS \"Prozent\" FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL"
        }
      ]
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Kostenverteilung im Budget-Fenster",
      "description": "Azure/AWS/Google aus den SpendLogs seit Beginn des aktuellen 30-Tage-Budget-Fensters (budget_reset_at âˆ’ 30 Tage); Serper/Firecrawl/Jina als FixbetrÃ¤ge aus den Variablen. Hinweis: SpendLogs zÃ¤hlen ALLE Keys, der Gauge links nur den Enforcement-ZÃ¤hler â€” kleine Abweichungen sind normal.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 0 },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "value"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Azure Foundry' AS \"Dienst\", round(coalesce(sum(spend), 0)::numeric, 2) AS \"USD\" FROM \"LiteLLM_SpendLogs\" WHERE coalesce(custom_llm_provider, '') NOT IN ('bedrock', 'vertex_ai') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL) UNION ALL SELECT 'AWS Bedrock', round(coalesce(sum(spend), 0)::numeric, 2) FROM \"LiteLLM_SpendLogs\" WHERE custom_llm_provider = 'bedrock' AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL) UNION ALL SELECT 'Google Vertex AI', round(coalesce(sum(spend), 0)::numeric, 2) FROM \"LiteLLM_SpendLogs\" WHERE custom_llm_provider = 'vertex_ai' AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL) UNION ALL SELECT 'Serper', ${serper_usd} UNION ALL SELECT 'Firecrawl', ${firecrawl_usd} UNION ALL SELECT 'Jina AI', ${jina_usd}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LLM-Spend (Fenster)",
      "description": "Enforcement-ZÃ¤hler des Virtual Keys â€” dieselbe Zahl, die LiteLLM gegen das Limit prÃ¼ft.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 6 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(spend::numeric, 2) AS \"USD\" FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LLM-Limit",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 6 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max_budget AS \"USD\" FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Budget-Reset am",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 6 },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/", "values": false } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(budget_reset_at, 'DD.MM.YYYY') AS \"Reset\" FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Gesamtkosten (Fenster)",
      "description": "LLM-Spend + Serper + Firecrawl + Jina (FixbetrÃ¤ge aus den Variablen).",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 9 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round((spend + ${serper_usd} + ${firecrawl_usd} + ${jina_usd})::numeric, 2) AS \"USD\" FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL"
        }
      ]
