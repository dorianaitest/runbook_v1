# LiteLLM gateway — NON-SECRET config only.
# Full reference: https://docs.litellm.ai/docs/proxy/configs
#
# Secrets are NOT stored here. They come from load-secrets.sh (Azure Key Vault)
# and are injected via the docker-compose 'environment:' block (interpolation),
# same model as infra/postgres — nothing sensitive on disk:
#   LITELLM_MASTER_KEY, DATABASE_URL (=LITELLM_DATABASE_URL),
#   AZURE_API_KEY, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY
#
# Copy to .env and fill in the endpoints/IDs below (these are not secret).

# ── Azure OpenAI (Backend 1) ────────────────────────────────────────────
# Models: o4-mini, gpt-4.1-mini, gpt-5-nano, grok-4-1-fast-reasoning, embeddings
# Provider ist openai/ in der config → Base im /openai/v1-Stil.
AZURE_API_BASE=https://<your-resource>.openai.azure.com/openai/v1

# Auto-Router: die semantic-router-Lib ruft das Embedding-Modell direkt via
# OPENAI_BASE_URL auf → identisch zu AZURE_API_BASE (dort liegt
# text-embedding-3-small). Key kommt als OPENAI_API_KEY aus dem Vault (Compose).
OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1

# ── Azure AI Foundry (Backend 2) ────────────────────────────────────────
# Models: gpt-5.4-nano/mini/full, DeepSeek-V3.2, Kimi-K2.6, Mistral-Large-3
AZURE_AI_GROK_BASE=https://<your-foundry-resource>.services.ai.azure.com/openai/v1

# ── Vertex AI (Gemini) ──────────────────────────────────────────────────
# GCP project id; auth via vertex-sa.json (GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_VERTEX_PROJECT=<your-gcp-project-id>

# ── Langfuse observability (EU cloud) ───────────────────────────────────
# Keys come from the vault (see above); only the host is set here.
LANGFUSE_HOST=https://cloud.langfuse.com
