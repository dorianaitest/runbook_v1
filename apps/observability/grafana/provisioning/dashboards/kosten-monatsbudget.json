          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "gridPos": { "h": 4, "w": 4, "x": 5, "y": 22 },
          "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT count(*) AS \"Bilder\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL)"
            }
          ]
        },
        {
          "id": 15,
          "type": "stat",
          "title": "Ã˜ Kosten pro Bild (Fenster)",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "gridPos": { "h": 4, "w": 5, "x": 9, "y": 22 },
          "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT round((coalesce(sum(spend), 0) / NULLIF(count(*), 0))::numeric, 4) AS \"USD\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL)"
            }
          ]
        },
        {
          "id": 16,
          "type": "piechart",
          "title": "Bild-Kosten nach Modell (Fenster)",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "gridPos": { "h": 9, "w": 10, "x": 14, "y": 22 },
          "options": {
            "pieType": "pie",
            "displayLabels": ["name", "value"],
            "legend": { "displayMode": "table", "placement": "bottom", "values": ["value", "percent"] },
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
            "tooltip": { "mode": "single" }
          },
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT CASE WHEN model ILIKE '%gpt-image%' THEN 'GPT-Image-2 (Azure)' ELSE 'Gemini 2.5 Flash Image (Google)' END AS \"Modell\", round(coalesce(sum(spend), 0)::numeric, 2) AS \"USD\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL) GROUP BY 1"
            }
          ]
        },
        {
          "id": 17,
          "type": "table",
          "title": "Ãœbersicht nach Modell (Budget-Fenster)",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "gridPos": { "h": 5, "w": 14, "x": 0, "y": 26 },
          "options": { "showHeader": true, "sortBy": [{ "displayName": "USD", "desc": true }] },
          "fieldConfig": {
            "defaults": { "custom": { "align": "auto", "filterable": false } },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "USD" },
                "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 4 }]
              },
              {
                "matcher": { "id": "byName", "options": "Ã˜/Bild" },
                "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 4 }]
              }
