# Hetzner Cloud API token for the letsencrypt-dns certresolver (DNS-01
# challenge, used for the *.artifacts.demo-ki-instanz.de wildcard cert).
#
# Must be a Hetzner Cloud API token with DNS read/write scope (the classic
# Hetzner DNS Console token no longer works with Traefik v3.7's bundled lego -
# see go-acme/lego's Hetzner provider docs). Generate it in the Hetzner Cloud
# Console, not the old DNS Console.
HETZNER_API_TOKEN=change-me
