# LiteLLM gateway secrets
# Full reference: https://docs.litellm.ai/docs/proxy/configs

# Master key used by LibreChat and FastAPI to authenticate against LiteLLM
LITELLM_MASTER_KEY=sk-change-me

# PostgreSQL connection for LiteLLM's own DB (tracks spend, keys, teams)
# Must match credentials in infra/postgres/.env (litellm user/db)
DATABASE_URL=postgresql://litellm:change-me@postgres:5432/litellm

# ── Azure OpenAI (Backend 1) ────────────────────────────────────────────
# Models: o4-mini, gpt-4.1-mini, gpt-5-nano, grok-4-1-fast-reasoning, embeddings
AZURE_API_KEY=
AZURE_API_BASE=https://<your-resource>.openai.azure.com/

# ── Azure AI Foundry (Backend 2) ────────────────────────────────────────
# Models: gpt-5.4-nano/mini/full, DeepSeek-V3.2, Kimi-K2.6, Mistral-Large-3
AZURE_AI_GROK_BASE=https://<your-foundry-endpoint>/

# ── Langfuse observability (EU cloud) ───────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_HOST=https://cloud.langfuse.com
