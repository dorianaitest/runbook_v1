    {
      "id": 9,
      "type": "stat",
      "title": "Requests im Fenster",
      "description": "Alle Requests in den SpendLogs seit Fensterbeginn (alle Keys).",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 9 },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Requests\" FROM \"LiteLLM_SpendLogs\" WHERE \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LLM-Kosten pro Tag (Azure / AWS / Google)",
      "description": "SpendLogs, folgt dem Zeitbereich oben rechts (Standard: 30 Tage).",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 9, "w": 15, "x": 0, "y": 12 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": { "mode": "normal", "group": "A" },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', \"startTime\") AS \"time\", CASE WHEN custom_llm_provider = 'bedrock' THEN 'AWS Bedrock' WHEN custom_llm_provider = 'vertex_ai' THEN 'Google Vertex AI' ELSE 'Azure Foundry' END AS \"metric\", sum(spend) AS \"value\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Kosten nach Modell (Budget-Fenster)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 9, "w": 9, "x": 15, "y": 12 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "USD", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": false } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "USD" },
            "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 4 }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(nullif(model_group, ''), model) AS \"Modell\", count(*) AS \"Requests\", sum(total_tokens) AS \"Tokens\", round(sum(spend)::numeric, 4) AS \"USD\" FROM \"LiteLLM_SpendLogs\" WHERE \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL) GROUP BY 1 ORDER BY 4 DESC LIMIT 15"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Bild-Kosten (gpt-image-2 / Gemini)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "panels": [
        {
          "id": 13,
          "type": "stat",
