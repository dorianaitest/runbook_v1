          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "gridPos": { "h": 4, "w": 5, "x": 0, "y": 22 },
          "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT round(coalesce(sum(spend), 0)::numeric, 2) AS \"USD\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL)"
            }
          ]
        },
        {
          "id": 14,
          "type": "stat",
          "title": "Bilder (Fenster)",
