# pii-gate: Presidio/GLiNER scrub service in front of Serper/Firecrawl

# Debug logging for scrub() matches: logs raw text plus per-match
# entity/offset/score at the /scrub and /serper call sites.
# Off by default — only turn on temporarily while tuning PII detection,
# then set back to false. Log the toggle (on and off) via /log.
PII_GATE_DEBUG_LOG=false
