# n8n workflow automation
#
# This .env holds ONLY the 4 Azure bootstrap credentials so that
# load-secrets.sh can authenticate to the Key Vault. All n8n config lives in
# docker-compose.yml; the two secrets (DB password N8N_POSTGRES_PASSWORD and
# N8N_ENCRYPTION_KEY) are pulled from the vault at deploy time and injected via
# the compose 'environment:' interpolation — no secrets on disk.
#
# Deploy:
#   cd /srv/apps/n8n
#   bash -c 'set -a && source .env && set +a \
#     && source /srv/runbook_v1/load-secrets.sh && docker compose up -d'
#
# Copy to .env and fill in from the Service Principal (Runbook 1.4).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=
