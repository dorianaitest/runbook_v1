# FastAPI + fastapi-postgres container credentials
# These must match the values in infra/postgres/.env if using the shared postgres,
# or be independent values for the dedicated fastapi-postgres container.

POSTGRES_USER=fastapi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fastapi

# Full connection string — must reference the container name as host
DATABASE_URL=postgresql://fastapi:change-me@fastapi-postgres:5432/fastapi

# LiteLLM master key — must match LITELLM_MASTER_KEY in overrides/librechat/litellm's env file (VPS-only, not tracked)
LITELLM_MASTER_KEY=sk-change-me

# API key for protecting the FastAPI gateway endpoints
AGENT_API_KEY=change-me
