{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "LiteLLM Postgres",
      "description": "Postgres-Datasource auf die litellm-DB (dieselbe wie beim Kosten-Dashboard)",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-30d", "to": "now" },
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["kosten", "bildgenerierung", "litellm"],
  "title": "Bild-Kosten (gpt-image-2 / Gemini)",
  "uid": "bild-kosten",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bild-Kosten (Budget-Fenster)",
      "description": "Summe aller Bildgenerierungs-Spends seit Beginn des aktuellen 30-Tage-Budget-Fensters. Filter: call_type aimage_generation (gpt-image-2 via Gateway) + pass_through_endpoint (Gemini via Vertex-Passthrough).",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(coalesce(sum(spend), 0)::numeric, 2) AS \"USD\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bilder (Fenster)",
      "description": "Anzahl Bildgenerierungs-Requests im Budget-Fenster.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 4, "w": 4, "x": 5, "y": 0 },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Bilder\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ã˜ Kosten pro Bild (Fenster)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round((coalesce(sum(spend), 0) / NULLIF(count(*), 0))::numeric, 4) AS \"USD\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL)"
        }
      ]
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Bild-Kosten nach Modell (Fenster)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 0 },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "value"],
        "legend": { "displayMode": "table", "placement": "bottom", "values": ["value", "percent"] },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN model ILIKE '%gpt-image%' THEN 'GPT-Image-2 (Azure)' ELSE 'Gemini 2.5 Flash Image (Google)' END AS \"Modell\", round(coalesce(sum(spend), 0)::numeric, 2) AS \"USD\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL) GROUP BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Ãœbersicht nach Modell (Budget-Fenster)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 5, "w": 14, "x": 0, "y": 4 },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "USD", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": false } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "USD" },
            "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 4 }]
          },
          {
            "matcher": { "id": "byName", "options": "Ã˜/Bild" },
            "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 4 }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN model ILIKE '%gpt-image%' THEN 'GPT-Image-2 (Azure)' ELSE 'Gemini 2.5 Flash Image (Google)' END AS \"Modell\", count(*) AS \"Bilder\", round(sum(spend)::numeric, 4) AS \"USD\", round((sum(spend) / NULLIF(count(*), 0))::numeric, 4) AS \"Ã˜/Bild\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND \"startTime\" >= (SELECT budget_reset_at - interval '30 days' FROM \"LiteLLM_VerificationToken\" WHERE max_budget IS NOT NULL) GROUP BY 1 ORDER BY 3 DESC"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bild-Kosten pro Tag",
      "description": "Folgt dem Zeitbereich oben rechts (Standard: 30 Tage).",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": { "mode": "normal", "group": "A" },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "litellm-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', \"startTime\") AS \"time\", CASE WHEN model ILIKE '%gpt-image%' THEN 'GPT-Image-2 (Azure)' ELSE 'Gemini 2.5 Flash Image (Google)' END AS \"metric\", sum(spend) AS \"value\" FROM \"LiteLLM_SpendLogs\" WHERE call_type IN ('aimage_generation', 'pass_through_endpoint') AND $__timeFilter(\"startTime\") GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    }
  ]
}
